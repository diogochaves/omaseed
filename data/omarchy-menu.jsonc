{
  // omaseed's block for Omarchy's menu (docs/DECISIONS.md C36 M13).
  //
  // Copy the lines from ">>> omaseed" to "<<< omaseed", both included, into
  // ~/.config/omarchy/extensions/omarchy-menu.jsonc, before its last "}" (the only file the
  // menu loads; it hot-reloads on save), or run
  // `scripts/dev/install-omarchy-extras.sh --menu`, which does the same. omaseed reads a
  // block between these markers as its own: it rewrites or removes everything from one marker
  // to the other, and nothing else in the file.
  //
  // `uwsm-app --` is the same launch wrapper Omarchy's own GUI-app rows use (see
  // "trigger.share.receive" in /usr/share/omarchy/default/omarchy/omarchy-menu.jsonc).
  // >>> omaseed · Trigger › Torrents · written by omaseed (Settings › Appearance); edits down to its end marker are replaced
  "torrents": {"icon":"󰇚","label":"Torrents","action":"uwsm-app -- omaseed"},
  // <<< omaseed
}
