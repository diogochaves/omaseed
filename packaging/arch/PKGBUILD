# Maintainer: Diogo Chaves <diogochaves@me.com>
#
# Builds from the tagged GitHub release source tarball (T5.3's scripts/release.sh cuts the
# tag, builds the tarball and replaces the sha256sums placeholder below). For a local build
# before any tag exists, or while iterating on packaging itself, use PKGBUILD.local next to
# this file instead -- it builds from the working tree.
pkgname=omaseed
pkgver=0.1.0
pkgrel=1
pkgdesc="Torrents for Omarchy, powered by qBittorrent"
arch=('x86_64')
url="https://github.com/diogochaves/omaseed"
license=('MIT')
# qtkeychain-qt6 talks to the freedesktop Secret Service directly over D-Bus (see its own
# `Depends On: ... org.freedesktop.secrets ...`, `ldd libqt6keychain.so.1` has no libsecret)
# rather than linking libsecret, so libsecret itself is not a real dependency here --
# omitted after checking (namcap flagged 'included, but may not be needed' when this list
# had it). A Secret Service provider (gnome-keyring, kwallet, keepassxc, ...) is what's
# actually required at runtime; qtkeychain-qt6 already depends on the virtual
# org.freedesktop.secrets package for that, so it does not need restating here either.
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-svg'
    'qt6-wayland'
    'qtkeychain-qt6'
    'hicolor-icon-theme'
)
makedepends=('cmake' 'ninja' 'librsvg')
optdepends=(
    'qbittorrent-nox: local engine, if you want omaseed to manage one for you on first run'
    'xdg-desktop-portal: native file picker for choosing .torrent files and download folders'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/diogochaves/omaseed/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

# No .install: current Arch convention leaves desktop-database, mime-database and (on the
# rare system without it already) icon-cache updates to the libalpm hooks shipped by
# desktop-file-utils, shared-mime-info and gtk-update-icon-cache respectively -- packages
# stopped carrying their own update-desktop-database/gtk-update-icon-cache .install calls
# once those hook packages became ubiquitous on any graphical install. omaseed does not
# depend on any of the three directly: they are present on essentially every desktop
# already (Omarchy's own base install pulls them in), and a system missing them just runs
# without a refreshed cache until something else triggers one, exactly like any other
# hicolor/.desktop-shipping package on Arch today.

build() {
    cmake -S "$pkgname-$pkgver" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    # data/CMakeLists.txt already installs LICENSE to share/licenses/omaseed/ (T5.1), so
    # there is nothing else to stage here.
    DESTDIR="$pkgdir" cmake --install build
}
