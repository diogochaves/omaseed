# Maintainer: Diogo Chaves <diogochaves@me.com>
#
# Local/working-tree variant of PKGBUILD, for trying the package before a git tag exists
# (T5.1). Builds from the checkout two directories up (packaging/arch/../..) instead of
# downloading a release tarball. Everything else -- depends, package() -- is identical to
# PKGBUILD; keep the two in sync by hand, since makepkg does not support templating.
#
# Usage (from packaging/arch/, never with -i / sudo -- see CLAUDE.md):
#   makepkg -p PKGBUILD.local -f
pkgname=omaseed
pkgver=0.4.0
pkgrel=1
pkgdesc="Torrents for Omarchy, powered by qBittorrent (local build)"
arch=('x86_64')
url="https://github.com/diogochaves/omaseed"
license=('MIT')
# See PKGBUILD for why libsecret is not listed: qtkeychain-qt6 talks to the Secret Service
# over D-Bus directly and already depends on org.freedesktop.secrets.
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-svg'
    'qt6-wayland'
    'qtkeychain-qt6'
    'hicolor-icon-theme'
)
# git and rsync: prepare() copies the working tree with them (PKGBUILD downloads a tarball).
makedepends=('cmake' 'ninja' 'librsvg' 'git' 'rsync')
optdepends=(
    'qbittorrent-nox: local engine, if you want omaseed to manage one for you on first run'
    'xdg-desktop-portal: native file picker for choosing .torrent files and download folders'
)
source=()
# The working tree has no fixed checksum; nothing to verify.

_repo_root() {
    # packaging/arch -> repo root, resolved from this PKGBUILD file's own location
    # (deliberately not the deprecated start-directory variable namcap flags) so it works
    # regardless of the caller's cwd -- srcdir is a scratch copy under build/, not the repo.
    local pkgbuild_dir
    pkgbuild_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    cd "$pkgbuild_dir/../.."
    pwd
}

prepare() {
    local root
    root="$(_repo_root)"
    rm -rf "$srcdir/$pkgname-$pkgver"
    # Copy the working tree as git sees it: tracked files plus new ones, nothing gitignored.
    # That leaves out build*/, dist/, .local/ scratch and reference/, the GPL clones read for
    # behaviour only, which must never sit inside this MIT package's sources.
    git -C "$root" ls-files -z --cached --others --exclude-standard |
        rsync -a --from0 --files-from=- --ignore-missing-args \
            "$root/" "$srcdir/$pkgname-$pkgver/"
}

build() {
    cmake -S "$pkgname-$pkgver" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    # data/CMakeLists.txt already installs LICENSE to share/licenses/omaseed/ (T5.1), so
    # there is nothing else to stage here.
    DESTDIR="$pkgdir" cmake --install build
}
